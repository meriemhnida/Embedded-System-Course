// Page « Mes réponses » : relit toutes les questions du parcours (dans l'ordre du menu),
// affiche les réponses enregistrées dans le navigateur et permet de les exporter ou de les importer.
import { getCollection } from 'astro:content';
import { leconsDuParcours } from '../scripts/leconsDuParcours';

interface QuestionInfo {
	id: string;
	label: string;
	type: string;
	enonce: string;
}
interface PageInfo {
	titre: string;
	href: string;
	questions: QuestionInfo[];
}
interface Groupe {
	cle: string;
	titre: string;
	pages: PageInfo[];
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lecons = leconsDuParcours(Astro.locals.starlightRoute.sidebar);
const docs = await getCollection('docs');
const parId = new Map(docs.map((d) => [d.id, d]));

const RE_QUESTION = /<Question\b([^>]*)>([\s\S]*?)<\/Question>/g;
const attribut = (attrs: string, nom: string) => attrs.match(new RegExp(`\\b${nom}="([^"]*)"`))?.[1];
const texteBrut = (md: string) =>
	md
		.replace(/```[\s\S]*?```/g, ' […] ')
		.replace(/`([^`]*)`/g, '$1')
		.replace(/\*\*([^*]+)\*\*/g, '$1')
		.replace(/\*([^*]+)\*/g, '$1')
		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
		.replace(/<[^>]+>/g, '')
		.replace(/\s+/g, ' ')
		.trim();
const cleDe = (titre: string) =>
	titre
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');

const groupes: Groupe[] = [];
for (const lecon of lecons) {
	const doc = parId.get(lecon.href.slice(base.length).replace(/\/$/, ''));
	if (!doc?.body) continue;
	const questions = [...doc.body.matchAll(RE_QUESTION)]
		.map(([, attrs, corps]) => ({
			id: attribut(attrs, 'id') ?? '',
			label: attribut(attrs, 'label') ?? '',
			type: attribut(attrs, 'type') ?? 'texte',
			enonce: texteBrut(corps),
		}))
		.filter((q) => q.id);
	if (questions.length === 0) continue;
	const titreGroupe = lecon.groupe;
	let groupe = groupes.find((g) => g.titre === titreGroupe);
	if (!groupe) {
