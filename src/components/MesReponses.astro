	}
	groupe.pages.push({ titre: lecon.label, href: lecon.href, questions });
}
const total = groupes.reduce((n, g) => n + g.pages.reduce((m, p) => m + p.questions.length, 0), 0);
---

<div class="mes-reponses" data-total={total}>
	<div class="ecran not-content">
		<p>
			Vos réponses aux questions des TP sont enregistrées <strong>automatiquement dans ce navigateur</strong>, sur
			cet appareil. Rien n'est envoyé sur Internet. Pour rendre votre travail, ou pour le reprendre sur un autre
			ordinateur, utilisez les boutons ci-dessous.
		</p>

		<div class="alerte" hidden data-role="alerte-stockage">
			⚠ Le stockage de ce navigateur est indisponible (navigation privée ou données bloquées) : les réponses ne
			pourront pas être conservées. Utilisez une fenêtre normale.
		</div>

		<fieldset class="identite">
			<legend>Identité (figure sur le compte rendu)</legend>
			<label>Nom <input type="text" name="nom" autocomplete="family-name" maxlength="80" /></label>
			<label>Prénom <input type="text" name="prenom" autocomplete="given-name" maxlength="80" /></label>
			<label>Groupe ou binôme <input type="text" name="groupe" maxlength="80" /></label>
		</fieldset>

		<div class="bilan">
			<p class="chiffres" data-role="chiffres">{total} questions dans le parcours.</p>
			<div class="barre" aria-hidden="true"><span class="remplissage"></span></div>
		</div>

		<div class="outils">
			<label class="selection">
				Exporter :
				<select data-role="selection">
					<option value="tout">tout le parcours</option>
					{groupes.map((g) => <option value={g.cle}>{g.titre}</option>)}
				</select>
			</label>
			<div class="boutons">
				<button type="button" class="principal" data-action="imprimer">Imprimer ou enregistrer en PDF</button>
				<button type="button" data-action="markdown">Télécharger le compte rendu (.md)</button>
				<button type="button" data-action="sauvegarder">Sauvegarder (.json)</button>
				<button type="button" data-action="importer">Importer une sauvegarde</button>
				<input type="file" accept="application/json,.json" data-role="fichier" hidden />
			</div>
			<p class="message" data-role="message" aria-live="polite"></p>
		</div>

		<details class="conseils">
			<summary>Bonnes pratiques</summary>
			<ul>
				<li>
					<strong>À la fin de chaque séance</strong>, téléchargez une sauvegarde (.json) : elle permet de retrouver vos
					réponses sur un autre appareil avec « Importer une sauvegarde ».
				</li>
				<li>
					<strong>Pour rendre un TP</strong>, choisissez-le dans la liste puis « Imprimer ou enregistrer en PDF », et
					déposez le PDF à l'endroit indiqué par l'enseignant.
				</li>
				<li>
					<strong>Sur un ordinateur partagé</strong> (salle de TP), effacez vos réponses de cet appareil une fois
					exportées : les suivants ne pourront pas les lire.
				</li>
				<li>Vider les données de navigation du navigateur efface aussi vos réponses.</li>
			</ul>
		</details>
	</div>

	<header class="impression">
		<p class="impression__titre">Compte rendu de travaux pratiques — Développement des applications embarquées</p>
		<p data-role="impression-identite"></p>
		<p data-role="impression-selection"></p>
	</header>

	{
		groupes.map((g) => (
			<section class="groupe" data-groupe={g.cle}>
				<h2>{g.titre}</h2>
				<p class="groupe__bilan" data-role="bilan-groupe" />
				{g.pages.map((p) => (
					<div class="page">
						<h3>
							<a href={p.href}>{p.titre}</a>
						</h3>
						<ol class="liste">
							{p.questions.map((q) => (
								<li class="item" data-id={q.id} data-label={q.label} data-type={q.type}>
									<div class="item__question">
										<span class="item__label">{q.label}</span>
										<span class="item__enonce">{q.enonce}</span>
									</div>
									<pre class="item__reponse" data-vide="true">Pas encore de réponse</pre>
									<div class="item__pied">
										<span class="item__date" />
										<a class="item__lien" href={`${p.href}#q-${q.id}`}>
											Répondre ou modifier →
										</a>
									</div>
								</li>
							))}
						</ol>
					</div>
				))}
			</section>
		))
	}

	<div class="ecran zone-danger not-content">
		<button type="button" class="danger" data-action="effacer">Effacer mes réponses de cet appareil</button>
	</div>
</div>

<script>
	import {
		effacerTout,
		enregistrerEtudiant,
		exporterJSON,
		importerJSON,
		lire,
		stockageDisponible,
	} from '../scripts/reponses';

	const racine = document.querySelector<HTMLElement>('.mes-reponses');
	if (racine) initialiser(racine);

	function dateHeure(iso: string): string {
		return new Date(iso).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
	}

	function nomFichier(...morceaux: string[]): string {
		return morceaux
			.filter(Boolean)
			.join('_')
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '')
			.replace(/[^A-Za-z0-9_-]+/g, '-')
			.replace(/-+/g, '-');
	}

	function telecharger(contenu: string, nom: string, type: string) {
		const url = URL.createObjectURL(new Blob([contenu], { type }));
		const lien = document.createElement('a');
		lien.href = url;
		lien.download = nom;
		document.body.append(lien);
		lien.click();
		lien.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	function initialiser(racine: HTMLElement) {
		const total = Number(racine.dataset.total ?? '0');
		const selection = racine.querySelector<HTMLSelectElement>('[data-role="selection"]')!;
		const message = racine.querySelector<HTMLElement>('[data-role="message"]')!;
		const fichier = racine.querySelector<HTMLInputElement>('[data-role="fichier"]')!;
		const champs = [...racine.querySelectorAll<HTMLInputElement>('.identite input')];

		if (!stockageDisponible()) racine.querySelector<HTMLElement>('[data-role="alerte-stockage"]')!.hidden = false;

		function afficherMessage(texte: string) {
			message.textContent = texte;
		}

		function groupesVisibles(): HTMLElement[] {
			return [...racine.querySelectorAll<HTMLElement>('.groupe')].filter((g) => !g.hidden);
		}

		function rafraichir() {
			const carnet = lire();
			for (const champ of champs) {
				const valeur = carnet.etudiant[champ.name as 'nom' | 'prenom' | 'groupe'] ?? '';
				if (document.activeElement !== champ) champ.value = valeur;
			}
			let faites = 0;
			racine.querySelectorAll<HTMLElement>('.groupe').forEach((groupe) => {
				let n = 0;
				let fait = 0;
				groupe.querySelectorAll<HTMLElement>('.item').forEach((item) => {
					n++;
					const r = carnet.reponses[item.dataset.id ?? ''];
					const zone = item.querySelector<HTMLElement>('.item__reponse')!;
					const date = item.querySelector<HTMLElement>('.item__date')!;
					if (r) {
						fait++;
						zone.textContent = r.texte;
						zone.dataset.vide = 'false';
						date.textContent = `Modifiée le ${dateHeure(r.maj)}`;
					} else {
						zone.textContent = 'Pas encore de réponse';
						zone.dataset.vide = 'true';
						date.textContent = '';
					}
				});
				faites += fait;
				groupe.querySelector<HTMLElement>('[data-role="bilan-groupe"]')!.textContent =
					`${fait} / ${n} question${n > 1 ? 's' : ''} répondue${fait > 1 ? 's' : ''}`;
			});
			const pourcent = total ? Math.round((faites / total) * 100) : 0;
			racine.querySelector<HTMLElement>('[data-role="chiffres"]')!.textContent =
				`${faites} / ${total} questions répondues (${pourcent} %)`;
			racine.querySelector<HTMLElement>('.remplissage')!.style.width = `${pourcent}%`;
			preparerImpression();
		}

		function appliquerSelection() {
			const valeur = selection.value;
			racine.querySelectorAll<HTMLElement>('.groupe').forEach((g) => {
				g.hidden = valeur !== 'tout' && g.dataset.groupe !== valeur;
			});
			preparerImpression();
		}

		function libelleSelection(): string {
			return selection.value === 'tout' ? 'Tout le parcours' : selection.selectedOptions[0]?.textContent ?? '';
		}

		function preparerImpression() {
			const { etudiant } = lire();
			const qui = [etudiant.prenom, etudiant.nom].filter(Boolean).join(' ') || '(nom non renseigné)';
			racine.querySelector<HTMLElement>('[data-role="impression-identite"]')!.textContent =
				`Étudiant(e) : ${qui}${etudiant.groupe ? ` — Groupe : ${etudiant.groupe}` : ''}`;
			racine.querySelector<HTMLElement>('[data-role="impression-selection"]')!.textContent =
				`${libelleSelection()} — exporté le ${dateHeure(new Date().toISOString())}`;
		}

		function compteRenduMarkdown(): string {
			const { etudiant, reponses } = lire();
			const lignes: string[] = [
				'# Compte rendu de travaux pratiques — Développement des applications embarquées',
				'',
				`- **Étudiant(e)** : ${[etudiant.prenom, etudiant.nom].filter(Boolean).join(' ') || '(non renseigné)'}`,
				`- **Groupe ou binôme** : ${etudiant.groupe || '(non renseigné)'}`,
				`- **Sélection** : ${libelleSelection()}`,
				`- **Exporté le** : ${dateHeure(new Date().toISOString())}`,
				'',
			];
			for (const groupe of groupesVisibles()) {
				lignes.push(`## ${groupe.querySelector('h2')?.textContent ?? ''}`, '');
				groupe.querySelectorAll<HTMLElement>('.page').forEach((page) => {
					lignes.push(`### ${page.querySelector('h3')?.textContent?.trim() ?? ''}`, '');
					page.querySelectorAll<HTMLElement>('.item').forEach((item) => {
						const r = reponses[item.dataset.id ?? ''];
						const enonce = item.querySelector('.item__enonce')?.textContent ?? '';
						lignes.push(`**${item.dataset.label}** — ${enonce}`, '');
						if (!r) lignes.push('_Pas de réponse._', '');
						else if (item.dataset.type === 'code') lignes.push('```cpp', r.texte, '```', '');
						else lignes.push(...r.texte.split('\n').map((l) => `> ${l}`), '');
					});
				});
			}
			return lignes.join('\n');
		}

		champs.forEach((champ) =>
			champ.addEventListener('input', () => {
				const ok = enregistrerEtudiant({
					nom: champs.find((c) => c.name === 'nom')!.value,
					prenom: champs.find((c) => c.name === 'prenom')!.value,
					groupe: champs.find((c) => c.name === 'groupe')!.value,
				});
				afficherMessage(ok ? '' : '⚠ Impossible d’enregistrer l’identité dans ce navigateur.');
				preparerImpression();
			}),
		);

		selection.addEventListener('change', appliquerSelection);

		racine.addEventListener('click', (evenement) => {
			const bouton = (evenement.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
			if (!bouton) return;
			const { etudiant } = lire();
			const date = new Date().toISOString().slice(0, 10);
<<<<<<< HEAD
			const quoi = selection.value === 'tout' ? 'parcours' : selection.value;
=======
			const quoi = selection.value === 'tout' ? 'parcours' : selection.value.split('-')[0];
>>>>>>> 0bb7b8852d3da41e642573f946f09ed4ef5ee63f
			switch (bouton.dataset.action) {
				case 'imprimer':
					preparerImpression();
					window.print();
					break;
				case 'markdown':
					telecharger(
						compteRenduMarkdown(),
						`${nomFichier('compte-rendu', quoi, etudiant.nom, etudiant.prenom, date)}.md`,
						'text/markdown;charset=utf-8',
					);
					afficherMessage('Compte rendu téléchargé.');
					break;
				case 'sauvegarder':
					telecharger(
						exporterJSON(),
						`${nomFichier('reponses', etudiant.nom, etudiant.prenom, date)}.json`,
						'application/json',
					);
					afficherMessage('Sauvegarde téléchargée : conservez ce fichier.');
					break;
				case 'importer':
					fichier.click();
					break;
				case 'effacer':
					if (
						confirm(
							'Effacer toutes vos réponses et votre identité de cet appareil ? Pensez à les sauvegarder avant : cette action est définitive.',
						)
					) {
						effacerTout();
						rafraichir();
						afficherMessage('Réponses effacées de cet appareil.');
					}
					break;
			}
		});

		fichier.addEventListener('change', async () => {
			const f = fichier.files?.[0];
			fichier.value = '';
			if (!f) return;
			if (f.size > 2_000_000) {
				afficherMessage('⚠ Fichier trop volumineux pour être une sauvegarde de réponses.');
				return;
			}
			const bilan = importerJSON(await f.text());
			if (!bilan) {
				afficherMessage('⚠ Ce fichier n’est pas une sauvegarde de réponses valide.');
				return;
			}
			rafraichir();
			afficherMessage(
				`Import terminé : ${bilan.ajoutees} réponse(s) ajoutée(s), ${bilan.misesAJour} mise(s) à jour, ${bilan.ignorees} déjà plus récente(s) ici.`,
			);
		});

		window.addEventListener('storage', rafraichir);
		window.addEventListener('beforeprint', preparerImpression);
		appliquerSelection();
		rafraichir();
	}
</script>

<style>
