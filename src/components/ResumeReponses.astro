---
// Bilan des réponses de la page courante, affiché en bas des pages qui contiennent des questions.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lien = `${base}mes-reponses/`;
---

<section class="resume-reponses" hidden>
	<div class="entete">
		<strong>Réponses de cette page</strong>
		<span class="compte"></span>
	</div>
	<div class="barre" aria-hidden="true"><span class="remplissage"></span></div>
	<p class="aide">
		Les réponses s'enregistrent automatiquement dans ce navigateur. En fin de séance, exportez-les depuis la page
		<a href={lien}>Mes réponses</a> pour les rendre ou les reprendre sur un autre appareil.
	</p>
</section>

<script>
	import { lire } from '../scripts/reponses';

	function mettreAJour(section: HTMLElement) {
		const ids = [...document.querySelectorAll<HTMLElement>('.question')].map((q) => q.dataset.id ?? '');
		if (ids.length === 0) return;
		section.hidden = false;
		const reponses = lire().reponses;
		const faites = ids.filter((id) => reponses[id]?.texte.trim()).length;
		section.querySelector<HTMLElement>('.compte')!.textContent = `${faites} / ${ids.length} question${ids.length > 1 ? 's' : ''}`;
		section.querySelector<HTMLElement>('.remplissage')!.style.width = `${Math.round((faites / ids.length) * 100)}%`;
	}

	document.querySelectorAll<HTMLElement>('.resume-reponses').forEach((section) => {
		mettreAJour(section);
		document.addEventListener('reponses:maj', () => mettreAJour(section));
	});
</script>

<style>
	.resume-reponses {
		margin-top: 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--cadre-vert-bord);
		border-radius: 0.75rem;
		background: var(--cadre-vert-fond);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.resume-reponses[hidden] {
		display: none;
	}
	.entete {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.compte {
		font-weight: 600;
	}
	.barre {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}
	.remplissage {
		display: block;
		height: 100%;
		width: 0;
		background: var(--cadre-vert-bord);
		transition: width 0.3s ease;
	}
	.aide {
		margin: 0;
		font-size: var(--sl-text-sm);
	}
	@media print {
		.resume-reponses {
			display: none;
		}
	}
</style>
