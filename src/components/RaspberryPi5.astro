---
import { categories, elements, ordre } from '../data/raspberry-pi5';

const couleur = Object.fromEntries(categories.map((c) => [c.id, c.couleur]));
const col = (id: string) => couleur[elements[id].categorie];
const cat = (id: string) => elements[id].categorie;
const label = (id: string) => elements[id].label;

// Les formes sont dessinées d'après la disposition de la carte telle qu'elle apparaît dans le cours
// (diapositive « Comprendre la carte Raspberry ») : ces fonctions convertissent des repères de la
// diapositive (px) en coordonnées du schéma.
const X = (px: number) => +(150 + (px - 395) * 0.81).toFixed(1);
const Y = (py: number) => +(80 + (py - 110) * 0.81).toFixed(1);
const W = (n: number) => +(n * 0.81).toFixed(1);

type Etiquette = { id: string; lignes: string[]; x: number; y: number; ancre: 'start' | 'middle' | 'end'; de: [number, number]; vers: [number, number][] };

const etiquettes: Etiquette[] = [
	{ id: 'gpio', lignes: ['Ports GPIO'], x: 390, y: 42, ancre: 'middle', de: [390, 50], vers: [[390, 84]] },
	{ id: 'ventilateur', lignes: ['Ventilateur'], x: 652, y: 42, ancre: 'middle', de: [646, 50], vers: [[646, 76]] },
	{ id: 'pcie', lignes: ['Bus PCIe'], x: 134, y: 277, ancre: 'end', de: [140, 272], vers: [[150, Y(347)]] },
	{ id: 'bouton', lignes: ['Bouton Power'], x: 134, y: 362, ancre: 'end', de: [140, 357], vers: [[150, Y(452)]] },
	{ id: 'led', lignes: ['Led d’état'], x: 134, y: 411, ancre: 'end', de: [140, 406], vers: [[150, Y(512)]] },
	{ id: 'usb', lignes: ['Ports USB'], x: 826, y: 150, ancre: 'start', de: [820, 145], vers: [[X(1196), 145]] },
	{ id: 'usb3', lignes: ['Ports USB 3'], x: 826, y: 289, ancre: 'start', de: [820, 284], vers: [[X(1196), 284]] },
	{ id: 'ethernet', lignes: ['Ethernet', 'Gigabit'], x: 826, y: 424, ancre: 'start', de: [820, 428], vers: [[X(1196), 428]] },
	{ id: 'usbc', lignes: ['USB-C', 'Alim.'], x: 205, y: 556, ancre: 'middle', de: [218, 540], vers: [[232, 514]] },
	{ id: 'batterie', lignes: ['Connecteur batterie'], x: 300, y: 604, ancre: 'middle', de: [288, 590], vers: [[288, 474]] },
	{ id: 'hdmi', lignes: ['Sortie vidéo', 'HDMI'], x: 392, y: 556, ancre: 'middle', de: [392, 540], vers: [[341, 514], [441, 514]] },
	{ id: 'camlcd', lignes: ['Ports Caméra', 'afficheurs LCD'], x: 540, y: 556, ancre: 'middle', de: [540, 540], vers: [[512, 502], [557, 502]] },
	{ id: 'poe', lignes: ['PoE'], x: 652, y: 556, ancre: 'middle', de: [650, 540], vers: [[626, 452]] },
];

---

