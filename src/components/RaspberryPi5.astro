</div>

<script>
	import { categories, elements, ordre } from '../data/raspberry-pi5';

	const nom = Object.fromEntries(categories.map((c) => [c.id, c]));

	document.querySelectorAll<HTMLElement>('.rpi').forEach((racine) => {
		const scene = racine.querySelector<HTMLElement>('.scene')!;
		const bulle = racine.querySelector<HTMLElement>('.info-bulle')!;
		const panneau = racine.querySelector<HTMLElement>('.panneau')!;
		const contenu = panneau.querySelector<HTMLElement>('.contenu')!;
		const invite = panneau.querySelector<HTMLElement>('.invite')!;
		const compteur = panneau.querySelector<HTMLElement>('.compteur')!;
		const noeuds = Array.from(racine.querySelectorAll<SVGGElement>('.el'));
		const boutons = Array.from(racine.querySelectorAll<HTMLButtonElement>('.liste button'));
		const parId = (id: string) => noeuds.filter((n) => n.dataset.id === id);
		let courant: string | null = null;
		let filtre: string | null = null;

		const afficherBulle = (n: Element) => {
			const e = elements[(n as HTMLElement).dataset.id!];
			if (!e) return;
			bulle.replaceChildren();
			const t = document.createElement('strong');
			t.textContent = e.titre;
			const r = document.createElement('span');
			r.textContent = e.resume;
			const c = document.createElement('em');
			c.textContent = 'Cliquez pour en savoir plus';
			bulle.append(t, r, c);
			bulle.hidden = false;
			const s = scene.getBoundingClientRect();
			const box = n.getBoundingClientRect();
			const lb = bulle.offsetWidth;
			let gauche = box.left + box.width / 2 - s.left - lb / 2;
			gauche = Math.max(4, Math.min(gauche, s.width - lb - 4));
			const dessous = box.top - s.top < 150 ? true : box.top - s.top < bulle.offsetHeight + 12;
			bulle.style.left = `${gauche}px`;
			bulle.style.top = dessous ? `${box.bottom - s.top + 8}px` : `${box.top - s.top - bulle.offsetHeight - 8}px`;
		};
		const cacherBulle = () => { bulle.hidden = true; };

		const choisir = (id: string) => {
			const e = elements[id];
			if (!e) return;
			courant = id;
			noeuds.forEach((n) => n.classList.toggle('sel', n.dataset.id === id));
			boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === id)));
			racine.dataset.actif = id;
			invite.hidden = true;
			contenu.hidden = false;
			const badge = contenu.querySelector<HTMLElement>('.badge')!;
			badge.textContent = nom[e.categorie].nom;
			badge.style.background = nom[e.categorie].couleur;
			contenu.querySelector('.titre')!.textContent = e.titre;
			contenu.querySelector('.resume')!.textContent = e.resume;
			const liste = contenu.querySelector('.points')!;
			liste.replaceChildren(...e.points.map((p) => { const li = document.createElement('li'); li.textContent = p; return li; }));
			contenu.querySelector<HTMLElement>('.vide')!.hidden = e.points.length > 0;
			const repere = contenu.querySelector<HTMLElement>('.repere')!;
			repere.replaceChildren();
			const fort = document.createElement('strong');
			fort.textContent = 'Où le repérer : ';
			repere.append(fort, e.repere);
			const lien = contenu.querySelector<HTMLElement>('.lien')!;
			lien.hidden = !e.lien;
			if (e.lien) {
				const a = lien.querySelector('a')!;
				a.textContent = `${e.lien.texte} →`;
				a.setAttribute('href', e.lien.href);
			}
			const i = ordre.indexOf(id);
			compteur.textContent = i >= 0 ? `${i + 1} / ${ordre.length}` : '';
		};

		noeuds.forEach((n) => {
			const id = n.dataset.id!;
			n.addEventListener('pointerenter', (ev) => { if ((ev as PointerEvent).pointerType === 'touch') return; parId(id).forEach((x) => x.classList.add('surv')); afficherBulle(n); });
			n.addEventListener('pointerleave', () => { parId(id).forEach((x) => x.classList.remove('surv')); cacherBulle(); });
			n.addEventListener('focus', () => afficherBulle(n));
			n.addEventListener('blur', cacherBulle);
			n.addEventListener('click', (ev) => { choisir(id); if ((ev as PointerEvent).pointerType === 'touch') cacherBulle(); else afficherBulle(n); });
			n.addEventListener('keydown', (ev) => {
				const k = (ev as KeyboardEvent).key;
				if (k === 'Enter' || k === ' ') { ev.preventDefault(); choisir(id); }
			});
		});
		boutons.forEach((b) => b.addEventListener('click', () => { choisir(b.dataset.id!); cacherBulle(); }));

		const pas = (d: number) => {
			const i = courant ? ordre.indexOf(courant) : d > 0 ? -1 : 0;
			choisir(ordre[(i + d + ordre.length) % ordre.length]);
			cacherBulle();
		};
		panneau.querySelector('.prec')!.addEventListener('click', () => pas(-1));
		panneau.querySelector('.suiv')!.addEventListener('click', () => pas(1));

		racine.querySelectorAll<HTMLButtonElement>('.filtre').forEach((b) => {
			b.addEventListener('click', () => {
				filtre = filtre === b.dataset.cat ? null : b.dataset.cat!;
				racine.querySelectorAll<HTMLButtonElement>('.filtre').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cat === filtre)));
				noeuds.forEach((n) => n.classList.toggle('estompe', !!filtre && n.dataset.cat !== filtre));
				boutons.forEach((b2) => b2.parentElement!.classList.toggle('estompe', !!filtre && elements[b2.dataset.id!].categorie !== filtre));
			});
		});
	});
</script>

