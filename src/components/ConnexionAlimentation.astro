---
// Animation de la connexion de l'alimentation : un fil rouge relie la broche 5V de la carte au rail + de la plaque de
// prototypage, puis un fil noir relie la broche GND au rail −. Les fils se tracent l'un après l'autre, une impulsion
// lumineuse les parcourt, les rails s'allument, puis la boucle recommence. Un bouton permet la mise en pause, et
// l'animation est remplacée par l'image finale si le visiteur demande de réduire les animations.
// Le dessin (carte et plaque) est un schéma original, aux couleurs fixes : il s'affiche sur un fond clair en thème sombre.
type Point = [number, number];

// Chemin à angles arrondis passant par une liste de points.
const arrondi = (pts: Point[], r = 8) => {
	let d = `M${pts[0][0]} ${pts[0][1]}`;
	for (let i = 1; i < pts.length - 1; i++) {
		const [px, py] = pts[i - 1];
		const [cx, cy] = pts[i];
		const [nx, ny] = pts[i + 1];
		const l1 = Math.hypot(cx - px, cy - py);
		const l2 = Math.hypot(nx - cx, ny - cy);
		const r1 = Math.min(r, l1 / 2);
		const r2 = Math.min(r, l2 / 2);
		d += ` L${cx - ((cx - px) / l1) * r1} ${cy - ((cy - py) / l1) * r1} Q${cx} ${cy} ${cx + ((nx - cx) / l2) * r2} ${cy + ((ny - cy) / l2) * r2}`;
	}
	const [lx, ly] = pts[pts.length - 1];
	return `${d} L${lx} ${ly}`;
};

// Plaque de prototypage : 30 colonnes, pas de 18, deux paires de rails (haut et bas).
const yb = 282; // haut de la plaque
const colX0 = 59;
const colonnes = Array.from({ length: 30 }, (_, i) => i);
const numeros = [0, 4, 9, 14, 19, 24, 29];
const yRangee = (k: number) => yb + 88 + 14 * k; // rangées a à e
const yRangeeB = (k: number) => yb + 178 + 14 * k; // rangées f à j
const rail = { stripeH: yb + 16, plusH: yb + 26, moinsH: yb + 42, bleuH: yb + 52, stripeB: yb + 258, plusB: yb + 268, moinsB: yb + 284, bleuB: yb + 294 };
const railX0 = 77; // origine des motifs de trous des rails : 5 groupes de 5 trous
const hauteurTotale = yb + 320;

// Broches de la carte (connecteur POWER) : le 5V est la cinquième, le GND la sixième.
const pinsPower = ['', 'IOREF', 'RESET', '3.3V', '5V', 'GND', 'GND', 'Vin'];
const pinX = (i: number) => 290 + 13 * i;
const pinsAnalog = ['A0', 'A1', 'A2', 'A3', 'A4', 'A5'];
const analogX = (i: number) => 394 + 13 * i;

// Les deux fils.
const xRouge = railX0 + 9; // premier trou du rail
const xNoir = railX0 + 27; // deuxième trou
const filRouge = arrondi([[pinX(4) + 4, 226], [pinX(4) + 4, 244], [xRouge, 244], [xRouge, rail.plusH]]);
const filNoir = arrondi([[pinX(5) + 4, 226], [pinX(5) + 4, 260], [xNoir, 260], [xNoir, rail.moinsH]]);
---

<figure class="ca">
	<svg
		class="ca__svg"
		viewBox={`0 0 640 ${hauteurTotale}`}
		role="img"
		aria-labelledby="ca-titre ca-desc"
		xmlns="http://www.w3.org/2000/svg"
	>
		<title id="ca-titre">Connexion de l’alimentation d’une plaque de prototypage</title>
		<desc id="ca-desc">
			Animation : un fil rouge relie la broche 5V de la carte Arduino au rail positif de la plaque, puis un fil noir relie la broche GND au rail de masse. Les deux rails
			s’allument une fois les fils branchés.
		</desc>
		<defs>
			<pattern id="ca-bornes-a" x={colX0 - 9} y={yRangee(0) - 7} width="18" height="14" patternUnits="userSpaceOnUse">
				<rect class="ca__trou" x="6" y="4" width="6" height="6" rx="1"></rect>
			</pattern>
			<pattern id="ca-bornes-b" x={colX0 - 9} y={yRangeeB(0) - 7} width="18" height="14" patternUnits="userSpaceOnUse">
				<rect class="ca__trou" x="6" y="4" width="6" height="6" rx="1"></rect>
			</pattern>
			<pattern id="ca-rail-h" x={railX0} y={rail.plusH - 8} width="99" height="32" patternUnits="userSpaceOnUse">
				<g class="ca__trou">
					{[6, 24, 42, 60, 78].map((x) => (
						<>
							<rect x={x} y="5" width="6" height="6" rx="1"></rect>
							<rect x={x} y="21" width="6" height="6" rx="1"></rect>
						</>
					))}
				</g>
			</pattern>
			<pattern id="ca-rail-b" x={railX0} y={rail.plusB - 8} width="99" height="32" patternUnits="userSpaceOnUse">
				<g class="ca__trou">
					{[6, 24, 42, 60, 78].map((x) => (
						<>
							<rect x={x} y="5" width="6" height="6" rx="1"></rect>
							<rect x={x} y="21" width="6" height="6" rx="1"></rect>
						</>
					))}
				</g>
			</pattern>
		</defs>

		<rect class="ca__fond" x="0" y="0" width="640" height={hauteurTotale}></rect>

		<!-- Carte de traitement (schéma d'une carte de type UNO) -->
		<g aria-hidden="true">
			<rect class="ca__usb" x="142" y="50" width="52" height="46" rx="2"></rect>
			<rect class="ca__jack" x="146" y="148" width="48" height="44" rx="4"></rect>
			<rect class="ca__carte" x="170" y="14" width="300" height="210" rx="10"></rect>
			<rect class="ca__reset" x="186" y="22" width="22" height="22" rx="3"></rect>
			<circle class="ca__reset-bouton" cx="197" cy="33" r="6"></circle>
			<rect class="ca__header" x="236" y="14" width="126" height="10" rx="1"></rect>
			<rect class="ca__header" x="374" y="14" width="92" height="10" rx="1"></rect>
			<text class="ca__t ca__t--carte" x="364" y="38" text-anchor="middle">DIGITAL (PWM ~)</text>
			<text class="ca__t ca__t--uno" x="318" y="96" text-anchor="middle">UNO</text>
			<text class="ca__t ca__t--carte" x="318" y="112" text-anchor="middle">ARDUINO</text>
			<rect class="ca__puce" x="294" y="150" width="150" height="26" rx="2"></rect>
			<line class="ca__pattes" x1="298" y1="148" x2="440" y2="148"></line>
			<line class="ca__pattes" x1="298" y1="178" x2="440" y2="178"></line>
			{
				pinsPower.map((nom, i) => (
					<>
						<rect class="ca__header" x={pinX(i)} y="212" width="8" height="14" rx="1"></rect>
						{nom && (
							<text
								class={`ca__t ca__t--pin${nom === '5V' || (nom === 'GND' && i === 5) ? ' ca__t--actif' : ''}`}
								transform={`translate(${pinX(i) + 7} 206) rotate(-90)`}
							>
								{nom}
							</text>
						)}
					</>
				))
			}
			{
				pinsAnalog.map((nom, i) => (
					<>
						<rect class="ca__header" x={analogX(i)} y="212" width="8" height="14" rx="1"></rect>
						<text class="ca__t ca__t--pin" transform={`translate(${analogX(i) + 7} 206) rotate(-90)`}>
							{nom}
						</text>
					</>
				))
			}
		</g>

		<!-- Plaque de prototypage -->
		<g aria-hidden="true">
			<rect class="ca__plaque" x="20" y={yb} width="600" height="308" rx="8"></rect>

			<!-- rails du haut -->
			<line class="ca__stripe ca__stripe--plus" x1="77" x2="572" y1={rail.stripeH} y2={rail.stripeH}></line>
			<line class="ca__stripe ca__stripe--moins" x1="77" x2="572" y1={rail.bleuH} y2={rail.bleuH}></line>
			<rect class="ca__lueur ca__lueur--plus ca-anim" x="75" y={rail.plusH - 8} width="499" height="16" rx="4"></rect>
			<rect class="ca__lueur ca__lueur--moins ca-anim" x="75" y={rail.moinsH - 8} width="499" height="16" rx="4"></rect>
			<rect x={railX0} y={rail.plusH - 8} width="495" height="32" fill="url(#ca-rail-h)"></rect>
			<text class="ca__t ca__signe ca__signe--plus" x="42" y={rail.plusH + 5} text-anchor="middle">+</text>
			<text class="ca__t ca__signe ca__signe--moins" x="42" y={rail.moinsH + 5} text-anchor="middle">−</text>

			<!-- zone centrale -->
			{numeros.map((i) => <text class="ca__t ca__t--num" x={colX0 + 18 * i} y={yb + 79} text-anchor="middle">{i + 1}</text>)}
			<rect x={colX0 - 9} y={yRangee(0) - 7} width="540" height="70" fill="url(#ca-bornes-a)"></rect>
			<rect class="ca__canal" x="28" y={yb + 150} width="584" height="14" rx="2"></rect>
			<rect x={colX0 - 9} y={yRangeeB(0) - 7} width="540" height="70" fill="url(#ca-bornes-b)"></rect>
			{numeros.map((i) => <text class="ca__t ca__t--num" x={colX0 + 18 * i} y={yb + 249} text-anchor="middle">{i + 1}</text>)}
			{
				['a', 'b', 'c', 'd', 'e'].map((l, k) => (
					<>
						<text class="ca__t ca__t--num" x="34" y={yRangee(k) + 3} text-anchor="middle">{l}</text>
						<text class="ca__t ca__t--num" x="606" y={yRangee(k) + 3} text-anchor="middle">{l}</text>
					</>
				))
			}
			{
				['f', 'g', 'h', 'i', 'j'].map((l, k) => (
					<>
						<text class="ca__t ca__t--num" x="34" y={yRangeeB(k) + 3} text-anchor="middle">{l}</text>
						<text class="ca__t ca__t--num" x="606" y={yRangeeB(k) + 3} text-anchor="middle">{l}</text>
					</>
				))
			}

			<!-- rails du bas -->
			<line class="ca__stripe ca__stripe--plus" x1="77" x2="572" y1={rail.stripeB} y2={rail.stripeB}></line>
			<line class="ca__stripe ca__stripe--moins" x1="77" x2="572" y1={rail.bleuB} y2={rail.bleuB}></line>
			<rect x={railX0} y={rail.plusB - 8} width="495" height="32" fill="url(#ca-rail-b)"></rect>
			<text class="ca__t ca__signe ca__signe--plus" x="42" y={rail.plusB + 5} text-anchor="middle">+</text>
			<text class="ca__t ca__signe ca__signe--moins" x="42" y={rail.moinsB + 5} text-anchor="middle">−</text>
		</g>

		<!-- Fils : tracé, impulsion, extrémités -->
		<g class="ca__fils ca-anim" aria-hidden="true">
			<path class="ca__fil ca__fil--rouge ca-anim" d={filRouge} pathLength="100"></path>
			<path class="ca__fil ca__fil--noir ca-anim" d={filNoir} pathLength="100"></path>
			<path class="ca__impulsion ca__impulsion--rouge ca-anim" d={filRouge} pathLength="100"></path>
			<path class="ca__impulsion ca__impulsion--noir ca-anim" d={filNoir} pathLength="100"></path>
			<circle class="ca__bout ca__bout--rouge ca-anim" cx={pinX(4) + 4} cy="226" r="4.5"></circle>
			<circle class="ca__bout ca__bout--noir ca-anim" cx={pinX(5) + 4} cy="226" r="4.5"></circle>
			<circle class="ca__prise ca__prise--rouge ca-anim" cx={xRouge} cy={rail.plusH} r="5.5"></circle>
			<circle class="ca__prise ca__prise--noir ca-anim" cx={xNoir} cy={rail.moinsH} r="5.5"></circle>
			<text class="ca__t ca__etiquette ca__etiquette--rouge ca-anim" x={pinX(4) - 8} y="238" text-anchor="end">5V</text>
			<text class="ca__t ca__etiquette ca__etiquette--noir ca-anim" x={pinX(5) - 8} y="276" text-anchor="end">GND</text>
			<text class="ca__t ca__tension ca__tension--plus ca-anim" x="596" y={rail.plusH + 5} text-anchor="middle">+5 V</text>
			<text class="ca__t ca__tension ca__tension--moins ca-anim" x="596" y={rail.moinsH + 5} text-anchor="middle">0 V</text>
		</g>
	</svg>

	<ul class="ca__legende">
		<li class="ca__legende-rouge"><strong>Fil rouge</strong> : broche <strong>5V</strong> de la carte → rail <strong>+</strong> de la plaque</li>
		<li class="ca__legende-noir"><strong>Fil noir</strong> : broche <strong>GND</strong> de la carte → rail <strong>−</strong> de la plaque</li>
	</ul>

	<p class="ca__controles">
		<button type="button" class="ca__pause" aria-pressed="false">Mettre l’animation en pause</button>
	</p>
</figure>

<script>
	document.querySelectorAll<HTMLElement>('.ca').forEach((fig) => {
		const bouton = fig.querySelector<HTMLButtonElement>('.ca__pause');
		if (!bouton) return;
		bouton.addEventListener('click', () => {
			const enPause = fig.classList.toggle('est-en-pause');
			bouton.setAttribute('aria-pressed', String(enPause));
			bouton.textContent = enPause ? 'Reprendre l’animation' : 'Mettre l’animation en pause';
		});
	});
</script>

<style>
	.ca {
		margin: 1.5rem 0;
		max-width: 34rem;
		margin-inline: auto;
	}
	.ca__svg {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.6rem;
		background: #f4f5f6;
	}
	.ca__fond {
		fill: #f4f5f6;
	}

	/* carte */
	.ca__carte {
		fill: #1f6da1;
		stroke: #154d75;
		stroke-width: 2;
	}
	.ca__usb {
		fill: #aeb3b8;
		stroke: #868b91;
		stroke-width: 1.5;
	}
	.ca__jack {
		fill: #26282c;
	}
	.ca__reset {
		fill: #dfe3e6;
	}
	.ca__reset-bouton {
		fill: #c1272d;
	}
	.ca__header {
		fill: #2b2d31;
	}
	.ca__puce {
		fill: #3b3e43;
	}
	.ca__pattes {
		stroke: #a9aeb4;
		stroke-width: 3;
		stroke-dasharray: 4 6;
	}
	.ca__t {
		font-family: inherit;
	}
	.ca__t--carte {
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.06em;
		fill: #e8f1f8;
	}
	.ca__t--uno {
		font-size: 28px;
		font-weight: 700;
		fill: #ffffff;
	}
	.ca__t--pin {
		font-size: 8.5px;
		font-weight: 500;
		fill: #e8f1f8;
	}
	.ca__t--actif {
		font-weight: 700;
		fill: #ffe08a;
	}

	/* plaque */
	.ca__plaque {
		fill: #efeee8;
		stroke: #c3c2b8;
		stroke-width: 2;
	}
	.ca__trou {
		fill: #7b7f84;
	}
	.ca__canal {
		fill: #dcdbd3;
	}
	.ca__stripe {
		stroke-width: 1.5;
	}
	.ca__stripe--plus {
		stroke: #e08a84;
	}
	.ca__stripe--moins {
		stroke: #8db4f0;
	}
	.ca__t--num {
		font-size: 8px;
		fill: #6b6f74;
	}
	.ca__signe {
		font-size: 20px;
		font-weight: 700;
	}
	.ca__signe--plus {
		fill: #d93025;
	}
	.ca__signe--moins {
		fill: #1f6feb;
	}

	/* fils */
	.ca__fil {
		fill: none;
		stroke-width: 4.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 100 100;
		stroke-dashoffset: 0;
	}
	.ca__fil--rouge {
		stroke: #d93025;
	}
	.ca__fil--noir {
		stroke: #202124;
	}
	.ca__impulsion {
		fill: none;
		stroke-width: 3;
		stroke-linecap: butt;
		stroke-dasharray: 8 200;
		stroke-dashoffset: -110;
	}
	.ca__impulsion--rouge {
		stroke: #ffb4ab;
	}
	.ca__impulsion--noir {
		stroke: #b9bec4;
	}
	.ca__bout,
	.ca__prise {
		transform-box: fill-box;
		transform-origin: center;
	}
	.ca__bout--rouge,
	.ca__prise--rouge {
		fill: #d93025;
	}
	.ca__bout--noir,
	.ca__prise--noir {
		fill: #202124;
	}
	.ca__prise {
		stroke: #ffffff;
		stroke-width: 1.5;
	}
	.ca__etiquette {
		font-size: 16px;
		font-weight: 700;
	}
	.ca__etiquette--rouge {
		fill: #d93025;
	}
	.ca__etiquette--noir {
		fill: #202124;
	}
	.ca__lueur {
		stroke: none;
	}
	.ca__lueur--plus {
		fill: rgba(217, 48, 37, 0.3);
	}
	.ca__lueur--moins {
		fill: rgba(31, 111, 235, 0.3);
	}
	.ca__tension {
		font-size: 15px;
		font-weight: 700;
	}
	.ca__tension--plus {
		fill: #d93025;
	}
	.ca__tension--moins {
		fill: #1f6feb;
	}

	/* légende et bouton */
	.ca__legende {
		list-style: none;
		margin: 0.7rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: var(--sl-text-sm);
	}
	.ca__legende li {
		margin: 0;
		position: relative;
		padding-inline-start: 2.2rem;
	}
	.ca__legende li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.6em;
		width: 1.6rem;
		height: 0.35rem;
		border-radius: 0.2rem;
	}
	.ca__legende-rouge::before {
		background: #d93025;
	}
	.ca__legende-noir::before {
		background: #202124;
		box-shadow: 0 0 0 1px #9aa0a6;
	}
	.ca__controles {
		margin: 0.6rem 0 0;
		text-align: center;
	}
	.ca__pause {
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.25rem 0.8rem;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.ca__pause:hover,
	.ca__pause:focus-visible {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-2);
	}

	/* animation : cycle de 10 s */
	.ca__fils.ca-anim {
		animation: ca-cycle 10s linear infinite;
	}
	.ca__fil--rouge.ca-anim {
		animation: ca-tracer-rouge 10s ease-in-out infinite;
	}
	.ca__fil--noir.ca-anim {
		animation: ca-tracer-noir 10s ease-in-out infinite;
	}
	.ca__impulsion--rouge.ca-anim {
		animation: ca-impulsion-rouge 10s ease-in infinite;
	}
	.ca__impulsion--noir.ca-anim {
		animation: ca-impulsion-noir 10s ease-in infinite;
	}
	.ca__bout--rouge.ca-anim {
		animation: ca-bout-rouge 10s linear infinite;
	}
	.ca__bout--noir.ca-anim {
		animation: ca-bout-noir 10s linear infinite;
	}
	.ca__prise--rouge.ca-anim {
		animation: ca-prise-rouge 10s ease-out infinite;
	}
	.ca__prise--noir.ca-anim {
		animation: ca-prise-noir 10s ease-out infinite;
	}
	.ca__etiquette--rouge.ca-anim {
		animation: ca-texte-rouge 10s linear infinite;
	}
	.ca__etiquette--noir.ca-anim {
		animation: ca-texte-noir 10s linear infinite;
	}
	.ca__lueur--plus.ca-anim,
	.ca__tension--plus.ca-anim {
		animation: ca-allumer-plus 10s ease-out infinite;
	}
	.ca__lueur--moins.ca-anim,
	.ca__tension--moins.ca-anim {
		animation: ca-allumer-moins 10s ease-out infinite;
	}
	.ca.est-en-pause .ca-anim {
		animation-play-state: paused;
	}

	@keyframes ca-cycle {
		0%,
		90% {
			opacity: 1;
		}
		97%,
		100% {
			opacity: 0;
		}
	}
	@keyframes ca-tracer-rouge {
		0%,
		5% {
			stroke-dashoffset: 100;
		}
		26%,
		100% {
			stroke-dashoffset: 0;
		}
	}
	@keyframes ca-tracer-noir {
		0%,
		30% {
			stroke-dashoffset: 100;
		}
		51%,
		100% {
			stroke-dashoffset: 0;
		}
	}
	@keyframes ca-impulsion-rouge {
		0%,
		27% {
			stroke-dashoffset: 8;
		}
		40%,
		100% {
			stroke-dashoffset: -110;
		}
	}
	@keyframes ca-impulsion-noir {
		0%,
		52% {
			stroke-dashoffset: 8;
		}
		65%,
		100% {
			stroke-dashoffset: -110;
		}
	}
	@keyframes ca-bout-rouge {
		0%,
		4% {
			opacity: 0;
		}
		5%,
		100% {
			opacity: 1;
		}
	}
	@keyframes ca-bout-noir {
		0%,
		29% {
			opacity: 0;
		}
		30%,
		100% {
			opacity: 1;
		}
	}
	@keyframes ca-prise-rouge {
		0%,
		25% {
			opacity: 0;
			transform: scale(0.3);
		}
		30% {
			opacity: 1;
			transform: scale(1.5);
		}
		36%,
