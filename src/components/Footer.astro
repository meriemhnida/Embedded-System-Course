---
import Default from '@astrojs/starlight/components/Footer.astro';
import ValidationLecon from './ValidationLecon.astro';
import { leconsDuParcours } from '../scripts/leconsDuParcours';

const lecons = leconsDuParcours(Astro.locals.starlightRoute.sidebar);
const index = lecons.findIndex((lecon) => lecon.href === Astro.url.pathname);
const estLecon = index !== -1;
const suivante = estLecon ? lecons[index + 1] : undefined;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const accueilParcours = `${base}mon-parcours/`;
---

<Default />

{
	estLecon && (
		<ValidationLecon
			lecon={lecons[index]}
			lecons={lecons}
			suivante={suivante}
			accueilParcours={accueilParcours}
		/>
	)
}
